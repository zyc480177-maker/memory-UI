# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/memoirs

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Owner account (auto-seeded on first run)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=changeme123

# AI - Google Gemini (primary for V1)
GEMINI_API_KEY=your-gemini-api-key

# Additional AI providers (V2+)
OPENAI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# File storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# OSS (production)
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Email (optional in dev — magic links logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@memoirs.app

# CORS
FRONTEND_URL=http://localhost:3000
